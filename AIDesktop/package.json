{
  "name": "aidesktop",
  "version": "0.1.1",
  "description": "EcoInference desktop app — local AI on Windows and macOS",
  "main": "./out/main/index.js",
  "author": "EcoInference",
  "homepage": ".",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "firebase": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "ai.ecoinference.desktop",
    "productName": "EcoInference",
    "directories": { "output": "dist" },
    "files": ["out/**/*"],
    "publish": {
      "provider": "generic",
      "url": "https://releases.ecoinference.ai/file/ecoinference-releases/",
      "channel": "latest"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "extraResources": [
        { "from": "resources/bin/llama-server", "to": "bin/llama-server" }
      ]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }],
      "signAndEditExecutable": false,
      "extraResources": [
        { "from": "resources/bin/win-${arch}", "to": "bin" }
      ]
    }
  }
}
