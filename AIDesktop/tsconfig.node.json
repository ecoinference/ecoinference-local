{
  "compilerOptions": {
    "composite":      true,
    "module":         "ESNext",
    "moduleResolution": "bundler",
    "target":         "ES2022",
    "lib":            ["ES2022"],
    "strict":         true,
    "esModuleInterop": true,
    "skipLibCheck":   true,
    "outDir":         "out",
    "types":          ["electron-vite/node", "node"],
    "paths": {}
  },
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*"]
}
