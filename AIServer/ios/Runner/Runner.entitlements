<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allows the app to use more than the default ~3 GB memory limit.
	     Required for loading large on-device models (Gemma 3n E2B = 3.1 GB).
	     Available on A12 Bionic and later (iPhone XS / iPad Pro 2018+). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>

	<!-- Extends the virtual address space available to the process.
	     Needed to memory-map large model weight files without address
	     space exhaustion on 64-bit devices. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
