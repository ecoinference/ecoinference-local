rules_version = '2';

// EcoInference Cloud Storage security rules.
//
// The only thing the apps put in Storage is a profile avatar, written by
// StorageService.uploadAvatar() as avatars/{uid}.jpg. Everything else is denied.

service firebase.storage {
  match /b/{bucket}/o {

    // ── avatars/{uid}.jpg ────────────────────────────────────────────────────
    match /avatars/{fileName} {

      // Public read. Avatars are surfaced through Firebase download URLs stored
      // in the profile's avatarURL field, so they're already effectively public;
      // making that explicit is honest rather than a change in exposure.
      allow read: if true;

      // Write only your own avatar, and only something that actually is a
      // reasonably sized JPEG.
      //
      // The 4 MB cap exists in StorageService on both clients, but a client-side
      // check is advisory only — anyone with the project config can call the
      // Storage API directly. Enforcing it here is what actually stops the
      // bucket being used as free file hosting, which matters more than usual
      // given this project pays for its own egress.
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size <= 4 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';

      // Removing an avatar is a profile update (clearing avatarURL), not an
      // object delete — the clients never delete from Storage. Left closed;
      // open it deliberately if account deletion later needs to purge the file.
      allow delete: if false;
    }

    // ── Everything else ──────────────────────────────────────────────────────
    // Models are served from Backblaze B2 via Cloudflare, not from Firebase
    // Storage, so nothing else should be reachable here.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
