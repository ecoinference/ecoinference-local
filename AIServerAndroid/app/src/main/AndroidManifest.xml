<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Foreground service — required for long-running HTTP server + downloads -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Optional OpenCL for GPU inference acceleration -->
    <uses-feature android:name="android.hardware.opengles.aep" android:required="false"/>

    <application
        android:name=".AiServerApplication"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">

        <!-- Native libraries required by LiteRT-LM GPU backend -->
        <uses-native-library android:name="libvndksupport.so"  android:required="false"/>
        <uses-native-library android:name="libOpenCL.so"       android:required="false"/>
        <uses-native-library android:name="libOpenCL-car.so"   android:required="false"/>
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false"/>

        <!--
            Headless foreground service.
            Not exported — only started internally by StartServerActivity.
        -->
        <service
            android:name=".service.AiServerService"
            android:foregroundServiceType="dataSync"
            android:exported="false">
        </service>

        <!--
            Transparent trampoline Activity for AIClient.

            On Android 12+ startForegroundService() from a cross-app
            BroadcastReceiver is blocked (ForegroundServiceStartNotAllowed-
            Exception). An Activity that is being launched IS granted the
            foreground-service-launch allowance (BFSL) while it executes
            onCreate(), so this is the only fully reliable cross-app
            trigger on modern Android.

            The Activity is transparent and calls finish() in onCreate
            before a frame is drawn — the user sees nothing.

            android:excludeFromRecents prevents it appearing in the task
            switcher; android:noHistory prevents it being added to the
            back stack.
        -->
        <activity
            android:name=".StartServerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="com.gemma4.aiserver.ACTION_START"/>
                <action android:name="com.gemma4.aiserver.ACTION_STOP"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

    </application>

    <!-- AIClient needs this to discover AIServer by package name -->
    <queries>
        <package android:name="com.gemma4.aiclient"/>
    </queries>

</manifest>
