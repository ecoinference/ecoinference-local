<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow plain HTTP:
    - Loopback: AIServer binds to 127.0.0.1 (no external exposure).
    - models.example.invalid: local Pi model server (HTTP until TLS is added).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">models.example.invalid</domain>
    </domain-config>
</network-security-config>
