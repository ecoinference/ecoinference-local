<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow plain HTTP on loopback only.
    AIServer binds exclusively to 127.0.0.1 so this does not expose
    any network traffic outside the device.
    Model downloads use https://models.example.invalid — no exception needed.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
