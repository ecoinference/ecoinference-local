# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart
*.freezed.dart

# Android
*.iml
.gradle/
local.properties
app/release/
app/debug/
**/.cxx/

# iOS
Pods/
# Local secrets — never commit.
# NOTE: these three rules said "AIServeriOS/" until 2026-07-30 — a path that stopped
# existing when the directory was renamed to AIiOS/ (commit 0e20452). For that whole
# window nothing here was actually ignored: Local.xcconfig got committed (it had once
# held a real HuggingFace token), and 91MB of vendored Google binaries plus the
# .tar.gz archives were one `git add -A` away from being committed too.
AIiOS/Local.xcconfig
# Downloaded xcframeworks and archives — regenerated by AIiOS/download_frameworks.sh.
# These WERE tracked despite the rules above, because the rules were added after the
# files had already been committed and .gitignore does not untrack anything. They were
# purged from history on 2026-08-20; the tree went from 310MB to 2MB. Don't re-add them.
AIiOS/Frameworks/
AIiOS/*.tar.gz
AIiOS/litertlm_official_extract/
AIiOS/litertlm_extracted/

# Desktop inference binaries — llama-server and its DLLs, per platform. Not tracked:
# they are ~130MB, they are built or downloaded per-platform, and vendoring them made
# the repo hostile to clone. See docs/DESKTOP.md for the static build recipe.
AIDesktop/resources/bin/
# AIiOS embedded-Python build artifacts — regenerated by setup.sh / mobile-forge,
# not source. ~850MB of compiled package wheels and xcframework binaries.
AIiOS/Python.xcframework/
AIiOS/app_packages/
ios-python/
mobile-forge/
*.xcworkspace
xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# IDEs
.idea/
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Local model weights (multi-GB GGUF/litertlm files) — never commit, fetched from B2
/models/

# AIFlutter — standalone LiteRT-LM/Flutter viability test app, not part of the
# shipped product and never tracked here. ~4.6GB of Flutter build output on disk;
# ignored so it stops showing up as untracked in every `git status`. Delete this
# rule if it should ever become a real tracked component.
/AIFlutter/

# AIServer — the stage-1 Flutter app, removed in a6b1f17 and archived to
# a separate EcoInference-Flutter-Archive repo. Its tracked files are gone, but ~5.7GB
# of build output still sits on local disk, and a plain `git add -A` would happily
# re-commit ~28 of those generated files (gradle wrappers, plugin registrants,
# ephemeral symlinks) because the generic Flutter rules above don't cover them.
# This keeps the removal from silently undoing itself.
/AIServer/
